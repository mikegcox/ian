{% embed 'partials/base.html.twig' %}

	{% set collection = page.collection() %}
    {% set feed_url = base_url %}

    {% if base_url == '/' %}
        {% set base_url = '' %}
    {% endif %}

    {% if base_url == base_url_relative %}
        {% set feed_url = base_url~'/'~page.slug %}
    {% endif  %}
    

	{% block content %}
    {% set blog_image = page.media.images|first %}
			{% if blog_image %}
        <section class="home-slider dark-bg">
            <!-- Hero Slider Section -->
            <div class="owl-carousel fullwidth-slider white o-flow-hidden">
                <div class="item bg-img parallax parallax-section1" style="background-image: url('{{ blog_image.url }}');">
                    <!-- Content -->
                    <div class="full-cap-wraper  light-color">
                        <div class="content-caption light-color">
                            <div class="container">
                                <div class="row title">
                                    <h2 class="h2">{{ page.title }}</h2>
                                    {% include 'partials/breadcrumbs.html.twig' %}
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- End Content -->
                </div>
            </div>
        </section>
        <div class="clearfix"></div>
            {% endif %}

<!-- CONTENT -->
    <section class="ptb ptb-sm-80">
        <div class="container">
            <div class="row">
                <!-- Post Item -->
                <div class="col-lg-9 col-md-9">
				{% for child in collection %}
			        {% include 'partials/blog_item.html.twig' with {'page':child, 'truncate':true} %}
			    {% endfor %}

                {% if config.plugins.pagination.enabled and collection.params.pagination %}
                    {% include 'partials/pagination.html.twig' with {'pagination':collection.params.pagination} %}
                {% endif %}                
                </div>
                <!-- BLOG SIDEBAR -->
                <div class="col-lg-3 col-md-3 mt-sm-60">
                {% include 'partials/sidebar.html.twig' %}
                </div>
                <!-- /BLOG SIDEBAR -->
            </div>
        </div>
    </section>

	{% endblock %}

{% endembed %}


