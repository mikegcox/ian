{% set shoppingcart_image = page.media.images|first %}

                    <div class="nf-item col-md-4 col-sm-6 col-xs-12 mb-30">
                        <div class="item-box">
                            <!-- Shop item images -->
                            <div class="shop-item">
                                <div class="item-img">
                                {% if shoppingcart_image %}
                                    {{ shoppingcart_image.cropResize(400,400).html(page.header.title,'shoppingcart-thumb-image') }}
                                {% else %}
                                <br><br><br>
                                {% endif %}
                                </div>
                                <div class="item-mask">
                                    <div class="item-mask-detail">
                                        <div class="item-mask-detail-ele">
                                            <a a href="{{ page.url }}" class="btn btn-line-xs btn-white-line"><i class="fa fa-eye"></i>See more / buy this book</a><br> 
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- End Shop item images -->

                            <!-- Shop item info -->
                            <div class="shop-item-info">
                                <a href="{{ page.url }}">
                                    <h6 class="shop-item-name">{{ page.header.title }}</h6>
                                </a>
                                <div class="shop-item-price"><span>{% include 'partials/shoppingcart_core_price.html.twig' with { price: page.header.price } %}</span></div>
                            </div>
                            <!-- Shop item info -->
                        </div>
                    </div>