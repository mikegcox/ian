{% extends 'partials/shoppingcart_core_base.html.twig' %}

{% block content %}
    {% if uri.param('token') == order.token %}
        <section class="ptb-60 ptb-sm-80">
            <div class="container">
                <div class="row">
                    <div class="col-md-8 col-md-offset-2">
                        <div class="shoppingcart-container shoppingcart__order-confirmation">
                            <h1>{{ "PLUGIN_SHOPPINGCART.THANKS_FOR_YOUR_ORDER"|t|e }}</h1>

                            {% include 'partials/shoppingcart_core_order_details.html.twig' %}
                        </div>
                    </div>
                </div>
            </div>
        </section>

        {# Order is complete: empty the browser cart so it can't be bought twice #}
        <script>
        (function () {
            var tries = 0;
            var t = setInterval(function () {
                tries++;
                if (window.ShoppingCart && typeof ShoppingCart.clearCart === 'function') {
                    try { ShoppingCart.clearCart(); } catch (e) {}
                    try { if (ShoppingCart.renderCart) { ShoppingCart.renderCart(); } } catch (e) {}
                    clearInterval(t);
                }
                if (tries > 40) { clearInterval(t); }
            }, 150);
            try { localStorage.removeItem('grav-shoppingcart-basket-data'); } catch (e) {}
        })();
        </script>
    {% endif %}
{% endblock %}
