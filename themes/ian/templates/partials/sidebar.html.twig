{% if config.plugins.socialbuttons.enabled %}
<div class="sidebar-widget">
    {% include 'partials/socialbuttons.html.twig' with {'url' : page.url} %}
</div>
{% endif %}

{% if config.plugins.simplesearch.enabled %}
<div class="sidebar-widget">
    {% include 'partials/simplesearch_searchbox.html.twig' %}
</div>
{% endif %}
{% if config.plugins.relatedpages.enabled and related_pages|length > 0 %}
<div class="sidebar-widget">
    <h5>Related Posts</h5>
    <hr>
    {% include 'partials/relatedpages.html.twig' %}
</div>
{% endif %}
{% if config.plugins.random.enabled %}
<div class="sidebar-widget">
	<h5>Random Article</h5>
    <hr>
	<a class="btn btn-default" href="{{ base_url_relative }}/random"><i class="fa fa-retweet"></i> I'm Feeling Lucky!</a>
</div>
{% endif %}
{% if config.plugins.taxonomylist.enabled %}
<div class="sidebar-widget">
    <h5>Categories</h5>
    <hr>
    {% include 'partials/categories.html.twig' with {'taxonomy':'category'} %}
</div>
{% endif %}
{% if config.plugins.archives.enabled %}
<div class="sidebar-widget">
    <h5>Popular Tags</h5>
    <hr>
    {% include 'partials/taxonomylist.html.twig' with {'taxonomy':'tag'} %}
</div>
{% endif %}
{% if config.plugins.archives.enabled %}
<div class="sidebar-widget">
    <h5>Archives</h5>
    <hr>
	{% include 'partials/archives.html.twig' %}
</div>
{% endif %}
{% if config.plugins.feed.enabled %}
<div class="sidebar-widget syndicate">
    <h5>Syndicate</h5>
    <hr>
    <a class="btn btn-default btn-default" href="{{ feed_url }}.atom"><i class="fa fa-rss-square"></i> Atom 1.0</a>
    <a class="btn btn-default btn-default" href="{{ feed_url }}.rss"><i class="fa fa-rss-square"></i> RSS</a>
</div>
{% endif %}

