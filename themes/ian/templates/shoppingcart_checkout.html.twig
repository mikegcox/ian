{% extends 'partials/shoppingcart_core_base.html.twig' %}

{% block javascripts %}
    {{ parent() }}
    {% do assets.addJs('plugin://shoppingcart/js/shoppingcart_checkout.js') %}
    {% do assets.addJs('plugin://shoppingcart/js/shoppingcart_checkout_events.js') %}
    {% do assets.addInlineJs('(function() { ShoppingCart.currentPageIsCheckout = true; }());') %}
{% endblock %}

{% block content %}
{% set blog_image = page.find('/images').media['banner-print-checkout2.jpg'] %}

    <section class="dark-bg">
        <div class="bg-img pt-80 pb-60" style="background-image: url('{{ blog_image.url }}');">
            <div class="content-caption light-color">
                <div class="container">
                    <div class="row title">
                        <h2 class="h2">{{ page.parent.title }}</h2>
                    </div>
                </div>
            </div>
        </div>
    </section>
        <div class="clearfix"></div>
        <section class="ptb-60 ptb-sm-80">
            <div class="container">
                <div class="row">
                    <div class="shoppingcart-container js__checkout__block col-md-12">
                        {% include 'partials/shoppingcart_core_cart.html.twig' %}
                        <h2>{{ 'PLUGIN_SHOPPINGCART.CHECKOUT_PAGE_TITLE'|t }}</h2>
                        {{ page.content }}
                        {% include 'partials/shoppingcart_checkout_form_legacy.html.twig' %}

                    </div>

                    <script>
                        (function() {
                            ShoppingCart.checkout_form_fields = {{ json_encode(config.plugins.shoppingcart.checkout_form.fields) }};
                        }());
                    </script>
                </div>

            </div>
        </section>


{% endblock %}
