                        <div class="row">
                            {% if page.media.images %}
                            <div class="col-md-12 blog-post-hr mb-30">
                                
                                <h2><a href="{{ page.url }}">{{ page.title }}</a></h2>
                                <div class="col-md-6">
                                    
                                    <figure>
                                        {{ page.media.images|first.cropResize(900,600).html('',page.title,'img-responsive') }}
                                    </figure>
                                </div>                                        

                                <div class="col-md-6">
                                    <div>{{ page.content }}</div>
                                </div>
                                <div class="clearfix mb-30"></div>
                                <hr />
                            </div>
                            {% else %}
                            <div class="col-md-12 blog-post-hr mb-30">
                                
                                <h2><a href="{{ page.url }}">{{ page.title }}</a></h2>
                                    <div class="mb-30">{{ page.content }}</div>
                               
                                
                                <hr />
                            </div>                            
                            
                            {% endif %}
                        </div>







