{% embed 'partials/base.html.twig' %}

	{% block content %}

{% if page.header.wallpaper %}
{% set blog_image = page.media.images[page.header.wallpaper] %}
{% else %}
{% set blog_image = page.media.images|first %}
{% endif %}


			{% if blog_image %}
        <section class="full-screen-intro bg-img dark-bg" style="background-image: url({{ blog_image.cropResize(1680,1680).url }})">
                    <div class="full-cap-wraper">
                        <div class="content-caption light-color">
                            <div class="container"> 
                                <h1 class="h1">{{ page.title }}</h1>
                                 
                                <div class="intro-scroll-down">
                                    <a class="scroll-down" href="#about">
                                        <span class="mouse">
                                            <span class="mouse-dot"></span>
                                        </span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
        <div id="about"></div>
            {% endif %}
    
    <section class="ptb ptb-sm-80">
        <div class="container">

            <div class="row">

				<!-- BLOG ARTICLE -->
                <div class="col-lg-9 col-md-9 blog-post-hr">
			    {% include 'partials/wallpaper_item.html.twig' with {'truncate':false,'big_header':true} %}
                </div>
                <div class="col-lg-3 col-md-3 mt-sm-30">
				{% include 'partials/wallpaper_sidebar.html.twig' %}
                </div>
            </div>
        </div>
    </section>

	{% endblock %}

{% endembed %}






