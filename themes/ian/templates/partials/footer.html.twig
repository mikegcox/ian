{# Site-wide mailing-list signup (replaces the _subscribe modular on Home / Commercial Decor) #}
<style>
  .site-subscribe { padding: 100px 0; }
  .site-subscribe .subscribe-inner { max-width: 760px; margin: 0 auto; padding: 0 60px; text-align: center; }
  .site-subscribe h3,
  .site-subscribe p,
  .site-subscribe .btn { text-transform: none; letter-spacing: normal; }
  .site-subscribe h3 { margin-bottom: 0; }
  .site-subscribe p { margin: 15px 0 35px; }
  .site-subscribe input,
  .site-subscribe .btn { margin-bottom: 15px; }
  @media (max-width: 767px) {
    .site-subscribe { padding: 60px 0; }
    .site-subscribe .subscribe-inner { padding: 0 20px; }
  }
</style>

<!-- Mailing List Subscribe -->
<section class="site-subscribe bg-gray">
    <div class="subscribe-inner">
        <h3 class="no-transform">Stay connected to the River</h3>
        <p>Join us for stories from the archive, rediscovered photographs, exhibitions, events and glimpses into the 1000 Islands through Ian&rsquo;s lens.</p>
        <form action="https://notifications.thousandislandslife.com/subscribe" method="POST" accept-charset="utf-8">
            <div class="row">
                <div class="col-sm-4">
                    <input class="input-md form-full" type="text" name="name" placeholder="Name">
                </div>
                <div class="col-sm-4">
                    <input class="input-md form-full" type="email" name="email" placeholder="Email Address" required>
                </div>
                <div class="col-sm-4">
                    <button class="btn btn-md btn-black form-full" type="submit">Subscribe</button>
                </div>
            </div>
            <div style="display:none;">
                <label for="hp">HP</label>
                <input type="text" name="hp" id="hp"/>
            </div>
            <input type="hidden" name="list" value="2T9Kcfn8926u9J892RD892teCkBg"/>
            <input type="hidden" name="subform" value="yes"/>
        </form>
    </div>
</section>
<!-- End Mailing List Subscribe -->

        <footer class="footer pt-80">
            <div class="container text-center">
                    <ul class="social">
                        {% if theme_config.social.email %}
                        <li><a href="mailto:{{ theme_config.social.email }}" class="social fa fa-envelope"></a></li>
                        {% endif %}
                        {% if theme_config.social.facebook %}
                        <li><a href="{{ theme_config.social.facebook }}" class="social fa fa-facebook"></a></li>
                        {% endif %}
                        {% if theme_config.social.instagram %}
                        <li><a href="{{ theme_config.social.instagram }}" class="social fa fa-instagram"></a></li>
                        {% endif %}
                        {% if theme_config.social.youtube %}
                        <li><a href="{{ theme_config.social.youtube }}" class="social fa fa-youtube"></a></li>
                        {% endif %}
                        {% if theme_config.social.twitter %}
                        <li><a href="{{ theme_config.social.twitter }}" class="social fa fa-twitter"></a></li>
                        {% endif %}
                        {% if theme_config.social.linkedin %}
                        <li><a href="{{ theme_config.social.linkedin }}" class="social fa fa-linkedin"></a></li>
                        {% endif %}
                        <li><img src="{{ base_url }}/images/dxo.png" title="dxo" /></li>
                    </ul>
                    <div>
                        <br />
                        &copy; {{ "now"|date("Y") }} <b>{{ site.title }}</b>
                    </div>
            </div>
            <!-- End Copyright Bar -->
        </footer>
