{% embed 'partials/base.html.twig' %}

	{% block content %}

    {% set blog_image = page.media.images|first %}
			{% if blog_image %}
        <section class="home-slider dark-bg">
            <!-- Hero Slider Section -->
            <div class="owl-carousel fullwidth-slider white o-flow-hidden">
                <div class="item bg-img parallax parallax-section1" style="background-image: url('{{ blog_image.url }}');">
                    <!-- Content -->
                    <div class="full-cap-wraper  light-color">
                        <div class="content-caption light-color">
                            <div class="container">
                                <div class="row title">
                                    <h2 class="h2">{{ page.title }}</h2>
                                    {% include 'partials/breadcrumbs.html.twig' %}
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- End Content -->
                </div>
            </div>
        </section>
        <div class="clearfix"></div>
            {% endif %}
    
    <section class="ptb ptb-sm-80">
        <div class="container">

            <div class="row">

				<!-- BLOG ARTICLE -->
                <div class="col-lg-9 col-md-9 blog-post-hr">
			    {% include 'partials/blog_item.html.twig' with {'truncate':false,'big_header':true} %}
                </div>
                <div class="col-lg-3 col-md-3 mt-sm-30">
				{% include 'partials/sidebar.html.twig' %}
                </div>
            </div>
        </div>
    </section>

	{% endblock %}

{% endembed %}






