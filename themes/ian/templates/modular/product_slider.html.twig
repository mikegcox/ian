
<!-- Contant Slider Section -->
        <section class="wow fadeIn ptb-60 ptb-sm-80">
            <div class="container">
                <div class="row">
                    <h1 class="text-center pb-60 no-transform">{{ page.title }}</h1>
                    <div class="owl-carousel item1-carousel nf-carousel-theme books-slider">
                        {% for slide in page.header.slides %}
                        <div class="item">
                            <div class="container">
                                <div class="row">
                                    <div class="col-md-6">
                                        <img src="{{ page.media[slide.image].cropResize(400,400).url }}" alt="" />
                                    </div>
                                    <div class="col-md-6">
                                        <h3>{{ slide.heading }}</h3>
                                        <div class="spacer-15"></div>
                                        <p>{{ slide.pitch }}</p>
                                        <div class="spacer-15"></div>
                                        {% if slide.purchase_url %}
                                        <a href="{{ slide.purchase_url}}" class="btn btn-md btn-black mt-15">See more / buy this book</a>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </section>
        <!-- End Contain Slider Section -->

    {% block bottom %}
        {% do assets.addJs('theme://js/plugin/owl.carousel.min.js', {'priority':69, 'group':'bottom'}) %}     
    {% endblock %}