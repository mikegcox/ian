{% extends 'partials/base.html.twig' %}

{% block content %}

{% if page.media.images %}
    {% set blog_image = page.media.images|first %}
{% else %}
    {% set blog_image = page.find('/images').media['default-page.jpg'] %}
{% endif %}

<section class="full-screen-intro bg-img dark-bg" style="background-image: url({{ blog_image.url }})">
    <div class="full-cap-wraper">
        <div class="content-caption light-color">
            <div class="container">
                <h1 class="h1">{{ page.title }}</h1>
                <div class="intro-scroll-down">
                    <a class="scroll-down" href="#about">
                        <span class="mouse">
                            <span class="mouse-dot"></span>
                        </span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
<div id="about"></div>
<div class="clearfix"></div>

<section class="ptb-60 ptb-sm-80">
    <div class="container">
        <div class="row">
            <div class="col-md-8 col-md-offset-2 text-center">

                {# Page content (intro copy) #}
                {% if page.content %}
                <div class="mb-30">{{ page.content }}</div>
                {% endif %}

                {# Primary CTA: Email Us #}
                {% if theme_config.social.email %}
                <div class="mb-60">
                    <a href="mailto:{{ theme_config.social.email }}" class="btn btn-lg btn-black">
                        Email Us
                    </a>
                </div>
                {% endif %}

                {# Secondary: Follow Along #}
                {% if theme_config.social.facebook or theme_config.social.instagram or theme_config.social.youtube %}
                <h5 class="pb-15">Follow Along</h5>
                <div class="row">
                    {% if theme_config.social.facebook %}
                    <div class="col-md-4 col-sm-4">
                        <p><a href="{{ theme_config.social.facebook }}" target="_blank">Facebook</a></p>
                    </div>
                    {% endif %}
                    {% if theme_config.social.instagram %}
                    <div class="col-md-4 col-sm-4">
                        <p><a href="{{ theme_config.social.instagram }}" target="_blank">Instagram</a></p>
                    </div>
                    {% endif %}
                    {% if theme_config.social.youtube %}
                    <div class="col-md-4 col-sm-4">
                        <p><a href="{{ theme_config.social.youtube }}" target="_blank">YouTube</a></p>
                    </div>
                    {% endif %}
                </div>
                {% endif %}

            </div>
        </div>
    </div>
</section>

{% endblock %}

{% block bottom %}
    {{ parent() }}
{% endblock %}