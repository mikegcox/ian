{% extends 'partials/base.html.twig' %}
    {% block content %}
			<!-- PAGE TOP -->
			<section class="page-title">
				<div class="container">

					<header>
                        {% include 'partials/breadcrumbs.html.twig' %}
						<h2><!-- Page Title -->
							<strong>{{ page.title }}</strong>
						</h2><!-- /Page Title -->

					</header>

				</div>			
			</section>

			<!-- /PAGE TOP -->

<!-- CONTENT -->  
    <section>
        <div class="container">
            <div class="row title-section">
				<div class="col-md-3"> 
                    <h4 class="">{{ page.parent.header.title }}</h4>
                    <ul class="side-nav list-group" id="sidebar-nav">
                                <li class="list-group-item"><a href="{{ page.parent.url }}">{{ page.parent.menu }}</a></li>
                                {% for p in page.parent.children %}
                                {% set current_page = (p.active or p.activeChild) ? 'active' : '' %}
                                <li class="list-group-item {{ current_page }}">
                                    <a href="{{ p.url }}">
                                        {{ p.menu }}
                                    </a>
                                </li>
                                {% endfor %}
                        
                                {% if page.parent.header.menuitems %}
                                {% for m in page.parent.header.menuitems %}
                                <li  class="list-group-item">
                                    <a href="{{ m.url }}">
                                        {{ m.text }}
                                    </a>
                                </li>
                                {% endfor %}
                    </ul>       
                    {% else %}
                    </ul>
                    {% endif %}
                        
                    {% if page.media.images %}
                    <div class="preview_footer_container">
                        <div class="footer_item section_box col-xs-12 col-sm-4 col-md-12">
                            {% for picture in page.media.images %}
                            {{ picture.lightbox(800,600).cropResize(400,400).html('','','thumbnail img-responsive') }}
                            {% endfor %}
                        </div>
                    </div>
                    {% endif %}
                </div>
                <div class="col-md-9">
                    <span></span>
	                {{ page.content }}	
                </div>
            </div>
        </div>
</section>
    {% endblock %}

