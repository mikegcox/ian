<!-- Art Showcase Carousel -->
<section class="wow fadeIn ptb-60 ptb-sm-80 {{ page.header.class }}">
<div class="container">
{% if page.title and not page.header.hide_title %}
<h2 class="text-center pb-60 no-transform">{{ page.title }}</h2>
{% endif %}

{% if page.content %}
<div class="row text-center">
<div class="col-md-8 col-md-offset-2">
{{ page.content }}
</div>
</div>
<div class="spacer-30"></div>
{% endif %}

{% if page.header.cta_1_url or page.header.cta_2_url %}
<div class="row mb-60">
<div class="col-md-8 col-md-offset-2 text-center">
{% if page.header.cta_1_url %}
<a href="{{ page.header.cta_1_url }}" class="btn btn-md btn-black">{{ page.header.cta_1_text|default('Learn More') }}</a>
{% endif %}
{% if page.header.cta_2_url %}
<a href="{{ page.header.cta_2_url }}" class="btn btn-md btn-black-line">{{ page.header.cta_2_text|default('Contact Us') }}</a>
{% endif %}
</div>
</div>
{% endif %}

<div class="row">
<div class="col-md-12">
<div class="owl-carousel image-slider o-flow-hidden art-showcase-slider">
{% for slide in page.header.slides %}
<div class="item">
<img class="img-responsive center-block" src="{{ page.media[slide.image].cropResize(1600, 1200).url }}" alt="{{ slide.caption|default('') }}" />
<div class="art-showcase-caption hidden">
<p>{{ slide.caption }}</p>
</div>
</div>
{% endfor %}
</div>
</div>
</div>

</div>
</section>
<!-- End Art Showcase Carousel -->

{% block bottom %}
{% do assets.addJs('theme://js/plugin/owl.carousel.min.js', {'priority':69, 'group':'bottom'}) %}
{% endblock %}